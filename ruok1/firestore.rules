rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isCoach() {
      return isAuthenticated() && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }

    // Rules for scheduled exercises root collection
    match /scheduledExercises/{exerciseId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||  // User can read their own scheduled exercises
        isCoach()                                    // Coaches can read all scheduled exercises
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||  // User can create their own scheduled exercises
        (isCoach() && request.resource.data.createdBy == request.auth.uid)  // Coaches can create exercises for their clients
      );
      
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||  // User can update their own scheduled exercises
        isCoach()                                    // Coaches can update their clients' scheduled exercises
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||  // User can delete their own scheduled exercises
        isCoach()                                    // Coaches can delete their clients' scheduled exercises
      );
    }

    // Rules for scheduled sessions root collection
    match /scheduledSessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||  // User can read their own scheduled sessions
        resource.data.createdBy == request.auth.uid ||  // Creator can read sessions they created
        isCoach()                                    // Coaches can read all scheduled sessions
      );
      
      allow create: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid && request.resource.data.createdBy == request.auth.uid) ||  // User can create their own scheduled sessions
        (isCoach() && request.resource.data.createdBy == request.auth.uid)  // Coaches can create sessions for their clients
      );
      
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||  // User can update their own scheduled sessions
        resource.data.createdBy == request.auth.uid ||  // Creator can update sessions they created
        isCoach()                                    // Coaches can update their clients' scheduled sessions
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||  // User can delete their own scheduled sessions
        resource.data.createdBy == request.auth.uid ||  // Creator can delete sessions they created
        isCoach()                                    // Coaches can delete their clients' scheduled sessions
      );
    }

    // Default rule for all other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}