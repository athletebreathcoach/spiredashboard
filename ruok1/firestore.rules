{
  "rules": {
    "scheduledSessions": {
      "$session": {
        ".read": "auth != null && resource.data.userId == auth.uid",
        ".write": "auth != null && (!resource.data || resource.data.userId == auth.uid)",
        ".validate": "newData.hasChildren(['userId', 'scheduledDate', 'activities'])",
        "userId": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "scheduledDate": {
          ".validate": "newData.isString() || newData.isNumber()"
        },
        "activities": {
          ".validate": "newData.isArray()"
        }
      }
    }
  }
}